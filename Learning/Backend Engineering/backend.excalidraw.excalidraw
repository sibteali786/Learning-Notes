		},
		{
			"id": "AdLHUf4e",
			"type": "text",
			"x": 772.3540038861079,
			"y": 17.90167058151475,
			"width": 287.13989333539195,
			"height": 81.29992241688824,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "dotted",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [
				"wh67xS5X37ybDxxq0rjXF"
			],
			"frameId": null,
			"index": "b9R",
			"roundness": null,
			"seed": 1652741143,
			"version": 716,
			"versionNonce": 1596643097,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1759772731460,
			"link": null,
			"locked": false,
			"text": "These methods an be called multiple \ntimes and same result can be expected.\n- like DELETE, GET and PUT\n- like we are trying to fetch data ( does not modiy anyth\nthing )\n- We can only delete a resource once \n- Put completely modifies a resource in server so calling it once or more\nhas no effect.",
			"fontSize": 8.129992241688823,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "These methods an be called multiple \ntimes and same result can be expected.\n- like DELETE, GET and PUT\n- like we are trying to fetch data ( does not modiy anyth\nthing )\n- We can only delete a resource once \n- Put completely modifies a resource in server so calling it once or more\nhas no effect.",
			"autoResize": false,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
		{
			"id": "EhRPCz1d",
			"type": "text",
			"x": 771.7594647708513,
			"y": -30.978770686779626,
			"width": 273.5211165358729,
			"height": 35.94622719295826,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "dotted",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [
				"wh67xS5X37ybDxxq0rjXF"
			],
			"frameId": null,
			"index": "b9S",
			"roundness": null,
			"seed": 1625348793,
			"version": 674,
			"versionNonce": 299011065,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1759772731460,
			"link": null,
			"locked": false,
			"text": "An HTTP method is idempotent if the intended effect on\nthe server of making a single request is the same as the\neffect of making several identical requests.",
			"fontSize": 9.58566058478887,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "An HTTP method is idempotent if the intended effect on\nthe server of making a single request is the same as the\neffect of making several identical requests.",
			"autoResize": false,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
