			"link": null,
			"locked": false,
			"text": "Functional Requirements\n- create a short url from a long url\n    - optionally support custom alias\n    - optionally support an expiration time\n- be redirected to the original url from the short url",
			"fontSize": 20,
			"fontFamily": 3,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Functional Requirements\n- create a short url from a long url\n    - optionally support custom alias\n    - optionally support an expiration time\n- be redirected to the original url from the short url",
			"autoResize": true,
